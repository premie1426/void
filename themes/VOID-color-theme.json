{
  "name": "void",
  "type": "dark",

  "colors": {
    "editor.background": "#0B0B0B",
    "editor.foreground": "#D4D4D4",

    "editor.selectionBackground": "#2A2A2A",
    "editor.lineHighlightBackground": "#171717",
    "editor.lineHighlightBorder": "#171717",

    "editorLineNumber.foreground": "#5E5E5E",
    "editorLineNumber.activeForeground": "#A8A8A8",

    "editorHoverWidget.background": "#121212",
    "editorWidget.background": "#121212",
    "editorGutter.background": "#0B0B0B",

    "editorGroupHeader.tabsBackground": "#0B0B0B",
    "editorGroupHeader.noTabsBackground": "#0B0B0B",
    "editorGroup.border": "#1C1C1C",
    "editorGroupHeader.border": "#1C1C1C",
    "editorGroupHeader.tabsBorder": "#1C1C1C",

    "scrollbarSlider.background": "#3A3A3AAA",
    "scrollbarSlider.hoverBackground": "#525252CC",
    "scrollbarSlider.activeBackground": "#6A6A6AFF",

    "activityBar.background": "#0B0B0B",
    "activityBar.foreground": "#B8B8B8",
    "activityBar.inactiveForeground": "#5E5E5E",
    "activityBarBadge.background": "#4A4A4A",
    "activityBarBadge.foreground": "#D4D4D4",
    "activityBar.border": "#1C1C1C",

    "sideBar.background": "#0B0B0B",
    "sideBar.foreground": "#BEBEBE",
    "sideBarTitle.foreground": "#D4D4D4",
    "sideBarSectionHeader.background": "#0F0F0F",
    "sideBarSectionHeader.foreground": "#D4D4D4",
    "sideBar.border": "#1C1C1C",
    "sideBarSectionHeader.border": "#1C1C1C",

    "titleBar.activeBackground": "#0B0B0B",
    "titleBar.activeForeground": "#CFCFCF",
    "titleBar.inactiveBackground": "#0B0B0B",
    "titleBar.inactiveForeground": "#6C6C6C",
    "titleBar.border": "#1C1C1C",

    "statusBar.background": "#141414",
    "statusBar.foreground": "#CFCFCF",
    "statusBar.border": "#1C1C1C",
    "statusBar.debuggingBackground": "#1E1E1E",
    "statusBar.noFolderBackground": "#141414",

    "tab.activeBackground": "#0B0B0B",
    "tab.activeForeground": "#D4D4D4",
    "tab.inactiveBackground": "#121212",
    "tab.inactiveForeground": "#707070",
    "tab.hoverBackground": "#171717",
    "tab.border": "#1C1C1C",
    "tab.activeBorderTop": "#4E4E4E",

    "panel.background": "#0B0B0B",
    "panel.border": "#1C1C1C",
    "panelTitle.activeBorder": "#4E4E4E",

    "list.activeSelectionBackground": "#1A1A1A",
    "list.activeSelectionForeground": "#D4D4D4",
    "list.inactiveSelectionBackground": "#151515",
    "list.inactiveSelectionForeground": "#B8B8B8",
    "list.hoverBackground": "#171717",
    "list.hoverForeground": "#D4D4D4",

    "menu.background": "#121212",
    "menu.foreground": "#CFCFCF",
    "menu.selectionBackground": "#1C1C1C",

    "dropdown.background": "#121212",
    "dropdown.foreground": "#D4D4D4",

    "quickInput.background": "#121212",
    "quickInputTitle.background": "#121212",
    "quickInput.foreground": "#D4D4D4",
    "quickInputList.focusBackground": "#1C1C1C",

    "input.background": "#121212",
    "input.foreground": "#D4D4D4",
    "input.border": "#2A2A2A",

    "breadcrumb.background": "#121212",
    "breadcrumb.foreground": "#AFAFAF",

    "notifications.background": "#121212",

    "editorGroup.dropBackground": "#1A1A1A",
    "editorOverviewRuler.background": "#0B0B0B",

    "icon.foreground": "#AFAFAF",

    "contrastBorder": "#242424"
  },

  "semanticHighlighting": true,

  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#6A9955",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "scope": [
        "storage.modifier.import",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "support.function",
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#F44747"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#569CD6"
      }
    }
  ]
}